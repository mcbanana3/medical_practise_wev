{
  "name": "private-practice-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "vars": {
    "APP_ENV": "local",
    "AUTH_MODE": "local-token",
    "DEMO_MODE": "local-only",
    "PUBLIC_ORIGIN": "http://127.0.0.1:5173",
    "ACCESS_ISSUER": "",
    "ACCESS_AUDIENCE": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "private-practice-demo",
      "database_id": "local-demo-only",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}