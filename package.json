{
  "name": "private-practice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @private-practice/web",
    "dev:api": "npm run dev --workspace @private-practice/api",
    "check:api": "npm run check --workspace @private-practice/api",
    "build": "npm run check:api && npm run build --workspace @private-practice/web",
    "preview:web": "npm run preview --workspace @private-practice/web"
  }
}